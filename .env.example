# Copia este archivo a .env y llénalo con tus credenciales reales.
# Obtén tus credenciales en: https://www.mercadopago.com.mx/developers/panel/app

# Token PRIVADO de Mercado Pago (NUNCA lo subas a git)
MP_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX

# Llave PÚBLICA (puede vivir en el frontend)
MP_PUBLIC_KEY=APP_USR-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# URL pública donde está hospedado el sitio (para back_urls y webhook)
PUBLIC_URL=http://localhost:3000

PORT=3000
